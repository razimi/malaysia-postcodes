# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication
API_KEYS_FILE=api_keys.json

# Rate Limiting
# Format: "number/period" where period can be: second, minute, hour, day
# Examples: "100/minute", "1000/hour", "10/second", "5000/day"
RATE_LIMIT=100/minute

# IP-based Rate Limiting (applies to all endpoints, including public ones)
# Set to empty or comment out to disable IP rate limiting
# Recommended: 1000/hour for public endpoints, stricter for production
IP_RATE_LIMIT=1000/hour

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
