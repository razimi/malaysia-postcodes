# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Log real client IPs (useful for debugging reverse proxy setup)
# Set to true to see: "Request from real IP: x.x.x.x (via proxy: y.y.y.y)"
LOG_CLIENT_IP=false

# Authentication
API_KEYS_FILE=api_keys.json

# Enable/disable API key authentication (true/false)
# When false: all endpoints are public, only IP rate limiting applies
# When true: endpoints require X-API-Key header (default)
REQUIRE_API_KEY=true

# Rate Limiting
# Format: "number/period" where period can be: second, minute, hour, day
# Examples: "100/minute", "1000/hour", "10/second", "5000/day"
RATE_LIMIT=100/minute

# IP-based Rate Limiting (applies to all endpoints, including public ones)
# Set to empty or comment out to disable IP rate limiting
# Recommended: 1000/hour for public endpoints, stricter for production
IP_RATE_LIMIT=1000/hour

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
